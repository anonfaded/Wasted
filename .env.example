# Copy to .env (gitignored) and fill in locally. Never commit real values.
#
# Dashboard source/local development: these three values are read by Vite/build.
# Only the publishable key is exposed to the browser; never put a secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DASHBOARD_URL=
#
# Optional local reference only for Supabase CLI/database/account work.
# The app and dashboard do not read these values; leave them empty unless you need them.
SUPABASE_PROJECT_REF=
SUPABASE_ACCOUNT_EMAIL=
SUPABASE_ACCOUNT_PASSWORD=
SUPABASE_DB_PASSWORD=
