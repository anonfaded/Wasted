# Copy this file to keystore.properties (gitignored) and fill in real values.
# Release builds are signed ONLY when keystore.properties exists; without it
# the release APK is UNSIGNED and cannot be installed over existing Wasted apps.
storeFile=keystore/wasted-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
